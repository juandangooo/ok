{
  "name": "curtains-wallpaper",
  "version": "1.0.0",
  "description": "Interactive curtains.js live wallpaper for macOS",
  "main": "main.js",
  "scripts": {
    "build": "esbuild src/renderer.js --bundle --format=iife --outfile=dist/renderer.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && npx electron-builder --mac --dir"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juandangooo/ok.git"
  },
  "bugs": {
    "url": "https://github.com/juandangooo/ok/issues"
  },
  "homepage": "https://github.com/juandangooo/ok#readme",
  "dependencies": {
    "curtainsjs": "^8.1.6"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "esbuild": "^0.28.2"
  },
  "private": true,
  "build": {
    "appId": "com.curtains.wallpaper",
    "productName": "Curtains Wallpaper",
    "mac": {
      "category": "public.app-category.lifestyle",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  }
}
